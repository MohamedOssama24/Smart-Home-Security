{
  "version": "2026.11-2",
  "description": "Device classification ruleset (docs/17-DEVICE-FINGERPRINTING.md). Patterns are case-insensitive and searched inside the value: anchor them when a whole value is meant. A category is chosen only with score >= threshold and (one STRONG evidence or two MODERATE evidences from independent sources): a single weak hint is never enough.",
  "threshold": 50,
  "weights": { "STRONG": 60, "MODERATE": 30, "WEAK": 10 },
  "rules": [
    { "id": "router.integration", "category": "ROUTER", "strength": "STRONG",
      "all": [ { "field": "router.self", "matches": "^(TR064|SNMP)$" } ],
      "note": "answers as the router the owner configured (TR-064 / SNMP)" },
    { "id": "router.upnp-igd", "category": "ROUTER", "strength": "MODERATE",
      "all": [ { "field": "method", "matches": "^UPNP_IGD$" } ] },
    { "id": "router.ssdp-igd", "category": "ROUTER", "strength": "MODERATE",
      "all": [ { "field": "ssdp.type", "matches": "InternetGatewayDevice|WANConnectionDevice|WANDevice" } ] },
    { "id": "router.hostname", "category": "ROUTER", "strength": "WEAK",
      "all": [ { "field": "hostname", "matches": "^(fritz\\.box|fritzbox|router|gateway|speedport|vodafone|tim-?hub|openwrt)" } ] },
    { "id": "router.http-title", "category": "ROUTER", "strength": "MODERATE",
      "all": [ { "field": "http.title", "matches": "fritz!?box|speedport|vodafone station|tim ?hub|openwrt|luci|\\brouter\\b|\\bgateway\\b" } ],
      "note": "title of the web interface (M9 port scan)" },
    { "id": "router.dns-service", "category": "ROUTER", "strength": "WEAK",
      "all": [ { "field": "service", "matches": "^dns$" } ] },

    { "id": "camera.mdns-axis", "category": "IP_CAMERA", "strength": "STRONG",
      "all": [ { "field": "mdns.service", "matches": "^_axis-video\\._tcp$" } ] },
    { "id": "camera.ssdp-type", "category": "IP_CAMERA", "strength": "MODERATE",
      "all": [ { "field": "ssdp.type", "matches": "NetworkVideoTransmitter|:device:(Camera|DigitalSecurityCamera)" } ] },
    { "id": "camera.mdns-rtsp", "category": "IP_CAMERA", "strength": "MODERATE",
      "all": [ { "field": "mdns.service", "matches": "^_rtsp\\._tcp$" } ] },
    { "id": "camera.ssdp-maker", "category": "IP_CAMERA", "strength": "MODERATE",
      "all": [ { "field": "ssdp.manufacturer", "matches": "hikvision|dahua|axis|reolink|amcrest|foscam|uniview|hanwha|vivotek" } ] },
    { "id": "camera.oui", "category": "IP_CAMERA", "strength": "WEAK",
      "all": [ { "field": "oui", "matches": "hikvision|dahua|axis communications|reolink|amcrest|foscam|uniview|hanwha|vivotek" } ] },
    { "id": "camera.hostname", "category": "IP_CAMERA", "strength": "WEAK",
      "all": [ { "field": "hostname", "matches": "(^|[-_])(cam|camera|ipcam|ipc|doorbell|nvr)([-_0-9]|$)" } ] },
    { "id": "camera.onvif", "category": "IP_CAMERA", "strength": "STRONG",
      "all": [ { "field": "service", "matches": "^onvif$" } ],
      "note": "answered the ONVIF device service on its own address" },
    { "id": "camera.rtsp-service", "category": "IP_CAMERA", "strength": "MODERATE",
      "all": [ { "field": "service", "matches": "^rtsp$" } ] },
    { "id": "camera.http", "category": "IP_CAMERA", "strength": "MODERATE",
      "all": [ { "field": "http.server", "matches": "hikvision|dahua|app-webs|dnvrs-webs|reolink|amcrest|foscam|ipcam" } ] },
    { "id": "camera.http-title", "category": "IP_CAMERA", "strength": "MODERATE",
      "all": [ { "field": "http.title", "matches": "network camera|ip ?camera|\\bnvr\\b|\\bdvr\\b|hikvision|dahua|reolink" } ] },

    { "id": "printer.mdns-ipp", "category": "PRINTER", "strength": "STRONG",
      "all": [ { "field": "mdns.service", "matches": "^_(ipp|ipps|printer|pdl-datastream)\\._tcp$" } ] },
    { "id": "printer.mdns-txt-ty", "category": "PRINTER", "strength": "MODERATE",
      "all": [ { "field": "mdns.txt.ty", "matches": "." } ] },
    { "id": "printer.ssdp-type", "category": "PRINTER", "strength": "MODERATE",
      "all": [ { "field": "ssdp.type", "matches": ":device:Printer:|:service:PrintBasic:" } ] },
    { "id": "printer.hostname", "category": "PRINTER", "strength": "WEAK",
      "all": [ { "field": "hostname", "matches": "printer|^hp[0-9a-f]{6}|^brn[0-9a-f]{6}|^epson|^canon" } ] },
    { "id": "printer.ipp-service", "category": "PRINTER", "strength": "STRONG",
      "all": [ { "field": "service", "matches": "^ipp$" } ],
      "note": "answered Get-Printer-Attributes" },
    { "id": "printer.jetdirect-port", "category": "PRINTER", "strength": "WEAK",
      "all": [ { "field": "port", "matches": "^tcp/(9100|515)$" } ] },

    { "id": "tv.mdns-model", "category": "SMART_TV", "strength": "STRONG",
      "all": [ { "field": "mdns.model", "matches": "chromecast|google tv|bravia|^appletv|apple tv|fire ?tv|roku" } ] },
    { "id": "tv.mdns-googlecast", "category": "SMART_TV", "strength": "MODERATE",
      "all": [ { "field": "mdns.service", "matches": "^_googlecast\\._tcp$" } ] },
    { "id": "tv.ssdp-renderer", "category": "SMART_TV", "strength": "MODERATE",
      "all": [ { "field": "ssdp.type", "matches": ":device:MediaRenderer:|dial-multiscreen-org:service:dial" } ] },
    { "id": "tv.ssdp-model", "category": "SMART_TV", "strength": "MODERATE",
      "all": [ { "field": "ssdp.product", "matches": "\\btv\\b|bravia|webos|tizen|roku|android ?tv|fire ?tv" } ] },
    { "id": "tv.mdns-airplay", "category": "SMART_TV", "strength": "WEAK",
      "all": [ { "field": "mdns.service", "matches": "^_airplay\\._tcp$" } ] },
    { "id": "tv.hostname", "category": "SMART_TV", "strength": "WEAK",
      "all": [ { "field": "hostname", "matches": "(^|[-_])(tv|bravia|roku|chromecast|firetv|appletv)([-_0-9]|$)" } ] },
    { "id": "tv.cast-port", "category": "SMART_TV", "strength": "WEAK",
      "all": [ { "field": "port", "matches": "^tcp/8009$" } ] },

    { "id": "speaker.mdns-model", "category": "SMART_SPEAKER", "strength": "STRONG",
      "all": [ { "field": "mdns.model", "matches": "google home|nest (mini|audio|hub)|homepod|audioaccessory" } ] },
    { "id": "speaker.mdns-sonos", "category": "SMART_SPEAKER", "strength": "MODERATE",
      "all": [ { "field": "mdns.service", "matches": "^_sonos\\._tcp$" } ] },
    { "id": "speaker.ssdp-maker", "category": "SMART_SPEAKER", "strength": "MODERATE",
      "all": [ { "field": "ssdp.manufacturer", "matches": "^sonos|bose" } ] },
    { "id": "speaker.mdns-spotify", "category": "SMART_SPEAKER", "strength": "WEAK",
      "all": [ { "field": "mdns.service", "matches": "^_spotify-connect\\._tcp$" } ] },
    { "id": "speaker.hostname", "category": "SMART_SPEAKER", "strength": "WEAK",
      "all": [ { "field": "hostname", "matches": "echo|alexa|homepod|sonos|google-home|nest-(mini|audio)" } ] },

    { "id": "phone.mdns-model", "category": "SMARTPHONE", "strength": "STRONG",
      "all": [ { "field": "mdns.model", "matches": "^iphone" } ] },
    { "id": "phone.hostname-product", "category": "SMARTPHONE", "strength": "MODERATE",
      "all": [ { "field": "hostname", "matches": "iphone|galaxy-?(s|a|z|note)|pixel-?[0-9]|redmi|oneplus" } ] },
    { "id": "phone.hostname-android", "category": "SMARTPHONE", "strength": "WEAK",
      "all": [ { "field": "hostname", "matches": "^android[-_]" } ] },

    { "id": "tablet.mdns-model", "category": "TABLET", "strength": "STRONG",
      "all": [ { "field": "mdns.model", "matches": "^ipad" } ] },
    { "id": "tablet.hostname", "category": "TABLET", "strength": "MODERATE",
      "all": [ { "field": "hostname", "matches": "ipad|galaxy-?tab" } ] },

    { "id": "laptop.mdns-model", "category": "LAPTOP", "strength": "STRONG",
      "all": [ { "field": "mdns.model", "matches": "^macbook" } ] },
    { "id": "laptop.hostname", "category": "LAPTOP", "strength": "MODERATE",
      "all": [ { "field": "hostname", "matches": "macbook|laptop|notebook|thinkpad" } ] },

    { "id": "desktop.mdns-model", "category": "DESKTOP", "strength": "STRONG",
      "all": [ { "field": "mdns.model", "matches": "^(imac|macmini|macpro|mac-?studio)" } ] },
    { "id": "desktop.hostname", "category": "DESKTOP", "strength": "MODERATE",
      "all": [ { "field": "hostname", "matches": "imac|mac-?mini|workstation" } ] },
    { "id": "desktop.hostname-windows", "category": "DESKTOP", "strength": "WEAK",
      "all": [ { "field": "hostname", "matches": "^desktop-[0-9a-z]{7}$" } ] },
    { "id": "desktop.rdp-port", "category": "DESKTOP", "strength": "WEAK",
      "all": [ { "field": "port", "matches": "^tcp/3389$" } ] },

    { "id": "nas.mdns-adisk", "category": "NAS", "strength": "MODERATE",
      "all": [ { "field": "mdns.service", "matches": "^_adisk\\._tcp$" } ] },
    { "id": "nas.mdns-vendor", "category": "NAS", "strength": "MODERATE",
      "all": [ { "field": "mdns.maker", "matches": "synology|qnap|asustor|terramaster|western digital|buffalo" } ] },
    { "id": "nas.ssdp-product", "category": "NAS", "strength": "MODERATE",
      "all": [ { "field": "ssdp.product", "matches": "synology|diskstation|qnap|my ?cloud|asustor|terramaster|readynas" } ] },
    { "id": "nas.hostname", "category": "NAS", "strength": "MODERATE",
      "all": [ { "field": "hostname", "matches": "diskstation|(^|[-_])nas([-_0-9]|$)|qnap|synology" } ] },
    { "id": "nas.mdns-smb", "category": "NAS", "strength": "WEAK",
      "all": [ { "field": "mdns.service", "matches": "^_(smb|afpovertcp)\\._tcp$" } ] },
    { "id": "nas.oui", "category": "NAS", "strength": "WEAK",
      "all": [ { "field": "oui", "matches": "synology|qnap" } ] },
    { "id": "nas.http-title", "category": "NAS", "strength": "MODERATE",
      "all": [ { "field": "http.title", "matches": "synology|diskstation|qnap|readynas|my ?cloud|truenas|asustor" } ] },
    { "id": "nas.afp-port", "category": "NAS", "strength": "WEAK",
      "all": [ { "field": "port", "matches": "^tcp/548$" } ] },

    { "id": "plug.hostname", "category": "SMART_PLUG", "strength": "MODERATE",
      "all": [ { "field": "hostname", "matches": "(^|[-_])(plug|socket)([-_0-9]|$)|^tapo-?p|^hs1[0-9]{2}|^kp[0-9]{3}|^shellyplug" } ] },

    { "id": "iot.mdns-hap", "category": "IOT", "strength": "MODERATE",
      "all": [ { "field": "mdns.service", "matches": "^_hap\\._(tcp|udp)$" } ] },
    { "id": "iot.hap-with-module-maker", "category": "IOT", "strength": "MODERATE",
      "all": [ { "field": "mdns.service", "matches": "^_hap\\._(tcp|udp)$" },
               { "field": "oui", "matches": "espressif|tuya|shenzhen" } ],
      "note": "two weak hints from independent sources combined" },
    { "id": "iot.hostname", "category": "IOT", "strength": "MODERATE",
      "all": [ { "field": "hostname", "matches": "^(tasmota|shelly|sonoff|esphome|wled|tuya)" } ] },
    { "id": "iot.mdns-mqtt", "category": "IOT", "strength": "WEAK",
      "all": [ { "field": "mdns.service", "matches": "^_(mqtt|esphomelib|shelly)\\._tcp$" } ] },
    { "id": "iot.coap-service", "category": "IOT", "strength": "WEAK",
      "all": [ { "field": "service", "matches": "^coap$" } ] },
    { "id": "iot.oui", "category": "IOT", "strength": "WEAK",
      "all": [ { "field": "oui", "matches": "espressif|tuya" } ] }
  ]
}
