# Copy to .env and replace EVERY value marked CHANGE_ME. Never commit .env.
# Generate strong values with:  openssl rand -base64 32

# --- Database -------------------------------------------------------------
SHSC_DB_NAME=shsc
# Bootstrap superuser: used only by the postgres container (init + admin tasks), never by the API
POSTGRES_SUPERUSER=shsc_admin
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
# Migration owner (Flyway, DDL)
SHSC_DB_MIGRATOR_USER=shsc_migrator
SHSC_DB_MIGRATOR_PASSWORD=CHANGE_ME
# Runtime role used by the API (DML only, cannot bypass Row-Level Security)
SHSC_DB_APP_USER=shsc_app
SHSC_DB_APP_PASSWORD=CHANGE_ME

# --- Public endpoint / TLS ------------------------------------------------
SHSC_PUBLIC_HOST=localhost
SHSC_HTTP_PORT=80
SHSC_HTTPS_PORT=443
# true only for development: Nginx creates a self-signed certificate.
# Production: false, and mount real certificates into the tls-certs volume.
SHSC_TLS_SELF_SIGNED=true

# --- Backend ----------------------------------------------------------------
# OpenAPI JSON + Swagger UI under /api/v1/docs (keep false in production)
SHSC_API_DOCS_ENABLED=false
SHSC_LOG_LEVEL=INFO
# ecs | logstash | gelf (structured JSON logs)
SHSC_LOG_FORMAT=ecs

# --- Authentication (Milestone 3) -------------------------------------------
# ES256 signing key for access tokens: base64 of a PKCS#8 DER P-256 private key.
# Generate with:  sh infrastructure/scripts/generate-jwt-key.sh   (one line, keep it secret)
SHSC_JWT_PRIVATE_KEY=CHANGE_ME
# Ed25519 key that signs the scan jobs sent to the agents (Milestone 6): base64 PKCS#8 DER.
# Generate with:  sh infrastructure/scripts/generate-job-signing-key.sh   (keep it secret;
# changing it requires enrolling the agents again, because they pin its public key)
SHSC_JOB_SIGNING_KEY=CHANGE_ME
# Public URL of the dashboard, used to build the links in e-mails (no trailing slash)
SHSC_PUBLIC_BASE_URL=https://localhost
# Refresh cookie with the Secure flag: keep true (the stack is HTTPS-only)
SHSC_COOKIE_SECURE=true
# Extra origins allowed by CORS (comma-separated). Empty = same-origin only (recommended).
SHSC_CORS_ALLOWED_ORIGINS=
# Lifetimes (ISO-8601 durations). Refresh token: 7 to 30 days.
SHSC_ACCESS_TOKEN_TTL=PT15M
SHSC_REFRESH_TOKEN_TTL=P14D
SHSC_SESSION_MAX_LIFETIME=P30D

# --- E-mail -------------------------------------------------------------------
SHSC_MAIL_FROM=no-reply@localhost
# Development: Mailpit (docker compose --profile dev). Production: your SMTP relay.
SHSC_SMTP_HOST=mailpit
SHSC_SMTP_PORT=1025
SHSC_SMTP_USERNAME=
SHSC_SMTP_PASSWORD=
SHSC_SMTP_AUTH=false
SHSC_SMTP_STARTTLS=false

# --- Images -----------------------------------------------------------------
SHSC_IMAGE_TAG=dev

# --- Backups (infrastructure/scripts/backup-db.sh) -----------------------
SHSC_BACKUP_DIR=./backups
SHSC_BACKUP_RETENTION_DAYS=14

# Registri OUI IEEE (opzionale): elenco separato da virgole di URL HTTPS (es. mirror interno).
# Non impostata (riga commentata) = i 3 CSV pubblici IEEE; non lasciarla vuota. La sincronizzazione parte solo manualmente (POST /api/v1/platform/oui/sync).
# SHSC_OUI_SOURCES=

# Feed vulnerabilità (M10, opzionale). La sincronizzazione parte solo manualmente da un platform admin
# (POST /api/v1/platform/vulnerabilities/sync). Chiave API NVD gratuita facoltativa: aumenta il limite di richieste.
# SHSC_NVD_API_KEY=
# Pausa tra le richieste NVD (senza chiave: almeno PT6S).
# SHSC_NVD_REQUEST_DELAY=PT6S

# Notifiche push dell'app (M14, opzionale, FCM gratuito). Progetto Firebase del proprietario; il JSON del
# service account va montato come file segreto nel container (mai nel repository). Vuoto = push disattivato.
# SHSC_FCM_PROJECT_ID=
# SHSC_FCM_CREDENTIALS_FILE=/run/secrets/fcm-service-account.json

# Assistente di sicurezza (M16). LOCAL = risposte deterministiche dai dati della casa (predefinito, gratuito).
# OLLAMA = LLM self-hosted opzionale; le risposte non supportate dai dati sono sostituite da quelle LOCAL.
# SHSC_ASSISTANT_PROVIDER=LOCAL
# SHSC_OLLAMA_URL=http://192.168.1.50:11434
# SHSC_OLLAMA_MODEL=llama3.2

# Abbonamenti SaaS con Stripe (M17, opzionale; ADR-072). Vuoto = disattivato. Solo chiavi di TEST
# (sk_test_ o rk_test_) salvo SHSC_STRIPE_ALLOW_LIVE=true. Webhook: /api/v1/billing/stripe/webhook
# SHSC_STRIPE_SECRET_KEY=sk_test_CHANGE_ME
# SHSC_STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
# SHSC_STRIPE_PRICE_PLUS=price_CHANGE_ME
# SHSC_STRIPE_PRICE_PRO=price_CHANGE_ME
# Prova gratuita in giorni, una sola per tenant (0 = nessuna, max 730)
# SHSC_STRIPE_TRIAL_DAYS=14
